{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["count", "currPage", "numPages", "items"],
  "properties": {
    "count": { "type": "integer" },
    "currPage": { "type": "integer" },
    "numPages": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uuid", "receiver", "envelope_uuid", "amount", "created"],
        "properties": {
          "uuid": { "type": "string" },
          "receiver": { "type": "string" },
          "envelope_uuid": { "type": "string" },
          "amount": { "type": "string" },
          "created": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}